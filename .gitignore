__pycache__/
*.py[cod]
.venv/
.env
*.egg-info/

# 데이터·인덱스·산출물
data/raw/
data/structured/*.db
data/graph/*.kuzu/
data/vector/

# 노트북
.ipynb_checkpoints/

# 수집 재현에 필요한 코드 매핑은 추적
!data/raw/code_grade.json

# 법령 원문은 재배포 대신 fetch 스크립트로 재현 (출처: 법제처)
data/law/

# 문서 청크·임베딩은 파생물, build 스크립트로 재현
data/documents/
data/graph/idc.kuzu*
data/runs/

# LaTeX 빌드 산출물
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/build.log
# 논문 원고 일체는 추적하지 않는다. 이 저장소는 public이고 계정은 실명인데
# 원고는 익명 심사 중이다 — PDF가 공개되면 제목 검색만으로 저자가 드러난다.
# 채택 후 camera-ready 시점에 다시 포함한다. 로컬 히스토리는 paper-history 브랜치.
paper/

# 평가 trace는 논문 재현에 필요하므로 추적한다(논문이 공개를 명시함, 수백 KB)
!eval/runs/*.jsonl
